{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axon",
  "version": "0.1.0",
  "identifier": "co.axon.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --mode desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../web run build -- --mode desktop",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axon",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8080; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

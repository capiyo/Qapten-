{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qapten.dev/contracts/qep/v1/envelope.schema.json",
  "title": "Qapten Exchange Protocol Envelope",
  "description": "Draft provider-neutral envelope for records exchanged through Qapten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_id",
    "workspace_id",
    "record_type",
    "created_at",
    "actor",
    "classification",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "record_type": {
      "enum": [
        "artifact",
        "context_bundle",
        "task",
        "handoff",
        "decision",
        "feedback",
        "event"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_type", "principal_id"],
      "properties": {
        "principal_type": {
          "enum": ["human", "agent", "system"]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 128
        },
        "capture_method": {
          "enum": [
            "manual_import",
            "user_authorized_browser_capture",
            "official_api",
            "qapten_generated"
          ]
        },
        "external_reference": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "classification": {
      "enum": ["public", "workspace", "restricted", "secret"]
    },
    "payload": {
      "type": "object"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": ["sha-256"]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}

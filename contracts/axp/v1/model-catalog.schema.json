{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon.local/contracts/axp/v1/model-catalog.schema.json",
  "title": "Axon OpenAI-Compatible Model Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["models"],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 3,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "display_name",
          "model",
          "base_url",
          "api_key_env",
          "capabilities"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "model": { "type": "string", "minLength": 1, "maxLength": 240 },
          "base_url": { "type": "string", "format": "uri" },
          "api_key_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          },
          "estimated_cost_per_1k_tokens": {
            "type": ["number", "null"],
            "minimum": 0
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axon:axp:v1:simulator-telemetry-ingest",
  "title": "Axon Simulator Telemetry Ingest Request",
  "description": "Development-only simulator input. The API stamps received_at and rejects non-simulated quality.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "sequence", "observed_at", "kind", "payload", "quality"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "kind": {"enum": ["pose", "velocity", "joint_state", "battery", "temperature", "safety_state", "diagnostic", "heartbeat"]},
    "frame_id": {"type": "string", "maxLength": 128},
    "payload": {"type": "object", "maxProperties": 128},
    "quality": {"const": "simulated"}
  }
}
